{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/toc.yml"
        ],
        "exclude": [
          "protected/**",
          "templates/**",
          "_site/**"
        ]
      }
    ],
    "template": [
      "default",
      "modern",
      "templates/azunt"
    ],
    "globalMetadata": {
      "_appName": "Azunt Docs",
      "_appTitle": "Azunt Documentation",
      "_appFooter": "Azunt Documentation \u00b7 ASP.NET Core 10 \u00b7 DocFX 2.78.5",
      "_enableSearch": true,
      "_disableContribution": true,
      "_lang": "en"
    },
    "sitemap": {
      "baseUrl": "https://azunt.com/docs/"
    },
    "postProcessors": [
      "ExtractSearchIndex"
    ]
  }
}

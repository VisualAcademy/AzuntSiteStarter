<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>Azunt.Site.Demo-2026</UserSecretsId>
    <BuildDocsOnBuild Condition="'$(BuildDocsOnBuild)' == ''">true</BuildDocsOnBuild>
    <DocFxVersion Condition="'$(DocFxVersion)' == ''">2.78.5</DocFxVersion>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepositoryRoot>
    <DocFxRoot>$([System.IO.Path]::Combine('$(RepositoryRoot)', 'docs', 'Azunt.Docs'))</DocFxRoot>
    <DocFxOutput>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)/DocFxSite'))</DocFxOutput>
    <DocFxBuildStamp>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)/DocFxBuild.stamp'))</DocFxBuildStamp>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../docs/Azunt.Docs/protected/**/*.md">
      <Link>ProtectedDocs/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Public DocFX sources live outside the ASP.NET Core project directory.
    Visual Studio's Fast Up-to-date Check does not automatically treat those files
    as build inputs, so explicitly register them. Any Markdown/TOC/template/config
    change then schedules an MSBuild build, which in turn rebuilds DocFX.
  -->
  <ItemGroup>
    <UpToDateCheckInput Include="$(DocFxRoot)/**/*.md" Set="DocFx" />
    <UpToDateCheckInput Include="$(DocFxRoot)/**/*.yml" Set="DocFx" />
    <UpToDateCheckInput Include="$(DocFxRoot)/docfx.json" Set="DocFx" />
    <UpToDateCheckInput Include="$(DocFxRoot)/templates/**/*" Set="DocFx" />
    <UpToDateCheckOutput Include="$(DocFxBuildStamp)" Set="DocFx" />
  </ItemGroup>

  <!--
    .NET 10's `dotnet tool exec` downloads/caches and invokes DocFX in one step.
    This avoids running `dotnet tool restore` from inside an MSBuild/Visual Studio build.
  -->
  <Target Name="BuildDocFx"
          BeforeTargets="Build"
          Condition="'$(BuildDocsOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Message Text="Building Azunt public documentation with DocFX $(DocFxVersion)..." Importance="high" />
    <RemoveDir Directories="$(DocFxOutput)" />
    <MakeDir Directories="$(DocFxOutput)" />
    <Exec WorkingDirectory="$(DocFxRoot)"
          Command="dotnet tool exec docfx@$(DocFxVersion) --allow-roll-forward -- build docfx.json --output &quot;$(DocFxOutput)&quot;" />
    <Touch Files="$(DocFxBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeDocFxInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildDocFx"
          Condition="'$(BuildDocsOnBuild)' == 'true' and Exists('$(DocFxOutput)')">
    <ItemGroup>
      <DocFxPublishFiles Include="$(DocFxOutput)/**/*" />
      <ResolvedFileToPublish Include="@(DocFxPublishFiles->'%(FullPath)')">
        <RelativePath>wwwroot/docs/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

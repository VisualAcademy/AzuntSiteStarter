<Router AppAssembly="typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <CascadingValue Value="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(LandingLayout)">
                <NotAuthorized Context="authState">
                    <RedirectToLogin AuthenticationState="authState" />
                </NotAuthorized>
                <Authorizing>
                    <div class="shell-width" style="padding: 4rem 0;">Authorizing...</div>
                </Authorizing>
            </AuthorizeRouteView>
        </CascadingValue>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

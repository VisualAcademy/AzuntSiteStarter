@page
@model Azunt.Web.Pages.Samples.Razor.Docs.PrivateModel
@{
    ViewData["Title"] = "Razor Pages Private Docs";
    var shell = AzuntShellViewData.Resolve(ViewData, AzuntShellKind.Docs, User);
}
<div class="docs-breadcrumb">
  <a href="/">Azunt</a><span>/</span><span>Samples</span><span>/</span><span>Private Docs</span>
</div>
<article class="markdown-body">
  <h1>Private Docs mode</h1>
  <p>This page demonstrates a protected Razor Page with the Docs shell explicitly rendered in <code>private</code> mode.</p>
  <p>Current mode: <code>@shell.ModeName</code></p>
</article>

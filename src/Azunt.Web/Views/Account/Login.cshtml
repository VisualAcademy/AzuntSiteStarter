@model LoginViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Sign in";
}
<div class="account-card">
  <span class="account-kicker">Azunt account</span>
  <h1>Sign in</h1>
  <p>Use the test account below, or register another account. InMemory data is cleared when the application restarts.</p>

  <div class="test-credential">
    <strong>Test account</strong>
    <span>demo@azunt.local</span>
    <span>Azunt123!</span>
  </div>

  <form method="post" asp-action="Login" asp-controller="Account" class="account-form">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label asp-for="Email"></label>
    <input asp-for="Email" autocomplete="username" />
    <span asp-validation-for="Email" class="field-error"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="current-password" />
    <span asp-validation-for="Password" class="field-error"></span>

    <label class="check-row"><input asp-for="RememberMe" /> <span>Keep me signed in</span></label>
    <button class="button button-primary button-full" type="submit">Sign in</button>
  </form>

  <p class="account-foot">Need another account? <a href="/account/register">Register</a>.</p>
</div>

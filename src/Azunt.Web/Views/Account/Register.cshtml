@model RegisterViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Register";
}
<div class="az-account-card">
  <span class="az-account-kicker">Local account</span>
  <h1>Create account</h1>
  <p>This site uses EF Core InMemory storage. Registered accounts are cleared when the application restarts.</p>
  <form method="post" asp-action="Register" asp-controller="Account" class="az-account-form">
    <div asp-validation-summary="ModelOnly" class="az-validation-summary"></div>
    <label asp-for="Email"></label>
    <input asp-for="Email" autocomplete="username" />
    <span asp-validation-for="Email" class="az-field-error"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="new-password" />
    <span asp-validation-for="Password" class="az-field-error"></span>

    <label asp-for="ConfirmPassword"></label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" />
    <span asp-validation-for="ConfirmPassword" class="az-field-error"></span>

    <button class="az-button az-button-primary az-button-full" type="submit">Create account</button>
  </form>
  <p class="az-account-foot">Already registered? <a href="/account/login">Sign in</a>.</p>
</div>

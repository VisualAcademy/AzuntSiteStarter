@model RegisterViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Register";
}
<div class="account-card">
  <span class="account-kicker">Local account</span>
  <h1>Create account</h1>
  <p>This site uses EF Core InMemory storage. Registered accounts are cleared when the application restarts.</p>
  <form method="post" asp-action="Register" asp-controller="Account" class="account-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label asp-for="Email"></label>
    <input asp-for="Email" autocomplete="username" />
    <span asp-validation-for="Email" class="field-error"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="new-password" />
    <span asp-validation-for="Password" class="field-error"></span>

    <label asp-for="ConfirmPassword"></label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" />
    <span asp-validation-for="ConfirmPassword" class="field-error"></span>

    <button class="button button-primary button-full" type="submit">Create account</button>
  </form>
  <p class="account-foot">Already registered? <a href="/account/login">Sign in</a>.</p>
</div>

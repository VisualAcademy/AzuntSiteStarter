@{
    ViewData["Title"] = "ASP.NET Core site";
}

<section class="az-hero-section">
  <div class="az-shell-width az-hero-grid">
    <div class="az-hero-copy">
      <span class="az-hero-kicker">ASP.NET Core 10</span>
      <h1>Public pages, courses, docs, dashboard, and account pages in one site.</h1>
      <p>Each area uses its own layout and navigation while sharing the same ASP.NET Core host, authentication, and build process.</p>
      <div class="az-hero-actions">
        <a class="az-button az-button-primary az-button-large" href="/dashboard">Open dashboard</a>
        <a class="az-button az-button-outline az-button-large" href="/courses">Courses</a>
        <a class="az-button az-button-outline az-button-large" href="/docs/">Documentation</a>
      </div>
      <div class="az-hero-note"><span class="az-status-dot"></span> .NET 10 · DocFX 2.78.5 · ASP.NET Core Identity</div>
    </div>
    <div class="az-cloud-visual" aria-hidden="true">
      <div class="az-visual-toolbar"><span></span><span></span><span></span><strong>Azunt</strong></div>
      <div class="az-visual-body">
        <div class="az-visual-sidebar"></div>
        <div class="az-visual-canvas">
          <div class="az-visual-heading"></div>
          <div class="az-visual-card-row"><i></i><i></i><i></i></div>
          <div class="az-visual-chart"><b></b><b></b><b></b><b></b><b></b><b></b></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="az-trust-strip">
  <div class="az-shell-width"><span>ASP.NET Core 10</span><span>DocFX 2.78.5</span><span>Identity</span><span>EF Core InMemory</span></div>
</section>

<section class="az-feature-section az-shell-width">
  <div class="az-section-heading"><span class="az-eyebrow">Site areas</span><h2>Four shells with shared content.</h2></div>
  <div class="az-feature-grid">
    <article><span class="az-feature-icon">☁</span><h3>Public</h3><p>Landing, product, and pricing pages use the public layout and navigation.</p><a href="/products">Public pages →</a></article>
    <article><span class="az-feature-icon">⌘</span><h3>Docs</h3><p>DocFX builds public Markdown. Protected Markdown is served through MVC after authorization.</p><a href="/docs/">Documentation →</a></article>
    <article><span class="az-feature-icon">▦</span><h3>Dashboard</h3><p>The dashboard uses authenticated routes, a multi-level sidebar, compact rail, and flyout navigation.</p><a href="/dashboard">Dashboard →</a></article>
    <article><span class="az-feature-icon">◉</span><h3>Account</h3><p>Sign-in, registration, profile, return URL, and access-denied pages use a separate account layout.</p><a href="/account/login">Sign in →</a></article>
  </div>
</section>

<section class="az-developer-band">
  <div class="az-shell-width az-developer-grid">
    <div><span class="az-eyebrow az-light">Project structure</span><h2>Keep source boundaries clear.</h2><p>DocFX stays static under /docs. Course Markdown is rendered inside the public layout, while protected docs remain behind ASP.NET Core authorization.</p></div>
    <pre><code>azunt.com/
├─ courses/       Public layout + Markdown
├─ docs/          DocFX
├─ docs/private/  MVC + Authorize
├─ dashboard/     MVC + Authorize
└─ account/       Identity</code></pre>
  </div>
</section>

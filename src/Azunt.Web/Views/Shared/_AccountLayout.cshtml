<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Azunt Account</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body class="account-body">
  <header class="account-header shell-width">
    <a class="brand" href="/"><span class="brand-mark">A</span><span>Azunt</span></a>
    <nav><a href="/docs/">Docs</a><a href="/">Public site</a></nav>
  </header>
  <main class="account-main">
    @RenderBody()
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Azunt Account</title>
  <link rel="stylesheet" href="~/css/azunt-core.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-account.css" asp-append-version="true" />
</head>
<body class="az-account-body">
  <header class="az-account-header az-shell-width">
    <a class="az-brand" href="/"><span class="az-brand-mark">A</span><span>Azunt</span></a>
    <nav><a href="/docs/">Docs</a><a href="/">Public site</a></nav>
  </header>
  <main class="az-account-main">
    @RenderBody()
  </main>
</body>
</html>

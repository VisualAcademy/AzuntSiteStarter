@using Azunt.Web.Models.Shells
@{
    var shell = AzuntShellViewData.Resolve(ViewData, AzuntShellKind.Dashboard, User);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Azunt Portal</title>
  <link rel="stylesheet" href="~/css/azunt-core.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-dashboard.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dashboard-body" data-az-shell="@shell.KindName" data-az-shell-mode="@shell.ModeName">
  <header class="portal-topbar">
    <button id="appLauncherToggle"
            class="portal-app-launcher"
            type="button"
            aria-label="Open Azunt apps"
            aria-controls="appLauncherMenu"
            aria-expanded="false"
            title="Apps">
      <span class="portal-waffle" aria-hidden="true">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
      </span>
    </button>
    <a class="portal-brand" href="/dashboard"><span class="brand-mark small">A</span><span>Azunt Portal</span></a>
    <button id="sidebarToggle" class="portal-hamburger" type="button" aria-label="Hide navigation" title="Hide navigation" aria-expanded="true">
      <span></span><span></span><span></span>
    </button>
    <nav class="portal-shortcuts" aria-label="Portal shortcuts">
      <a href="/dashboard">⌂ Dashboard</a>
      <a href="/dashboard/resources">＋ Resources</a>
      <a href="/docs/">Docs</a>
    </nav>
    <div class="portal-actions">
      <a href="/">Public site</a>
      <a class="avatar" href="/account/profile">@((User.Identity?.Name ?? "U")[0].ToString().ToUpperInvariant())</a>
    </div>
  </header>

  <section id="appLauncherMenu" class="portal-app-menu" aria-hidden="true" aria-label="Azunt apps">
    <div class="portal-app-menu-header">
      <div>
        <strong>Azunt</strong>
        <span>Sites and tools</span>
      </div>
      <a href="/">Home</a>
    </div>

    <nav class="portal-app-grid" aria-label="Azunt applications">
      <a class="portal-app-item" href="/">
        <span class="portal-app-icon app-icon-home"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#home"></use></svg></span>
        <span>Public site</span>
      </a>
      <a class="portal-app-item" href="/dashboard">
        <span class="portal-app-icon app-icon-dashboard"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#dashboard"></use></svg></span>
        <span>Dashboard</span>
      </a>
      <a class="portal-app-item" href="/dashboard/resources">
        <span class="portal-app-icon app-icon-resources"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#resources"></use></svg></span>
        <span>Resources</span>
      </a>
      <a class="portal-app-item" href="/courses">
        <span class="portal-app-icon app-icon-courses"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#courses"></use></svg></span>
        <span>Courses</span>
      </a>
      <a class="portal-app-item" href="/docs/">
        <span class="portal-app-icon app-icon-docs"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#docs"></use></svg></span>
        <span>Documentation</span>
      </a>
      <a class="portal-app-item" href="/docs/private/">
        <span class="portal-app-icon app-icon-protected"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#shield"></use></svg></span>
        <span>Protected docs</span>
      </a>
      <a class="portal-app-item" href="/account/profile">
        <span class="portal-app-icon app-icon-account"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#account"></use></svg></span>
        <span>Account</span>
      </a>
      <a class="portal-app-item" href="/products">
        <span class="portal-app-icon app-icon-products"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#products"></use></svg></span>
        <span>Products</span>
      </a>
      <a class="portal-app-item" href="/pricing">
        <span class="portal-app-icon app-icon-pricing"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#pricing"></use></svg></span>
        <span>Pricing</span>
      </a>
    </nav>

    <div class="portal-app-menu-divider"></div>
    <div class="portal-app-quick-links">
      <a href="/dashboard/resources">Browse resources <span aria-hidden="true">→</span></a>
      <a href="/courses/aspnet-core">Browse courses <span aria-hidden="true">→</span></a>
      <a href="/docs/getting-started/site-structure">Getting started <span aria-hidden="true">→</span></a>
      <a href="/account/profile">Profile and account <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <div class="portal-frame">
    <aside id="portalSidebar" class="portal-sidebar">
      <div class="portal-sidebar-tools" role="group" aria-label="Navigation tools">
        <button id="dashboardNavSearchToggle" class="portal-sidebar-tool" type="button"
                aria-label="Search menus" title="Search menus"
                aria-controls="dashboardNavSearchPanel" aria-expanded="false">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.5"/><path d="m13 13 4.4 4.4"/></svg>
          <span>Search</span>
        </button>
        <button id="dashboardNavCollapseAll" class="portal-sidebar-tool" type="button"
                aria-label="Collapse all menu groups" title="Collapse all menu groups">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 15.8h14M3 4.2h14m-11 8.3 4-4 4 4"/></svg>
          <span>Collapse All</span>
        </button>
      </div>
      <div class="portal-sidebar-scroll">
        @await Component.InvokeAsync("DashboardNavigation")
      </div>
      <nav class="portal-sidebar-fixed-links" aria-label="Quick shortcuts">
        <a href="#" class="portal-sidebar-fixed-link is-hawaso" data-placeholder-link title="Hawaso" aria-label="Hawaso">
          <span class="portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#webapp"></use></svg></span>
          <span class="portal-sidebar-fixed-text">Hawaso</span>
        </a>
        <a href="#" class="portal-sidebar-fixed-link is-dotnetnote" data-placeholder-link title="DotNetNote" aria-label="DotNetNote">
          <span class="portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#devops"></use></svg></span>
          <span class="portal-sidebar-fixed-text">DotNetNote</span>
        </a>
        <a href="#" class="portal-sidebar-fixed-link is-visualacademy" data-placeholder-link title="VisualAcademy" aria-label="VisualAcademy">
          <span class="portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#wireframe"></use></svg></span>
          <span class="portal-sidebar-fixed-text">VisualAcademy</span>
        </a>
      </nav>
      <button id="sidebarFooterToggle" class="portal-sidebar-footer-toggle" type="button" aria-label="Collapse navigation" title="Collapse navigation">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.4 4.8 7.2 10l5.2 5.2" /></svg>
      </button>
    </aside>

    <div id="dashboardNavFlyout"
         class="dashboard-nav-flyout"
         aria-hidden="true"
         aria-label="Dashboard submenu">
      <div id="dashboardNavFlyoutContent" class="dashboard-nav-flyout-content"></div>
    </div>

    <section id="dashboardNavSearchPanel" class="dashboard-nav-search-panel" hidden
             role="dialog" aria-label="Search dashboard menus">
      <div class="dashboard-nav-search-title">
        <strong>Search menus</strong>
        <button type="button" id="dashboardNavSearchClose" aria-label="Close menu search" title="Close">×</button>
      </div>
      <label class="dashboard-nav-search-label" for="dashboardNavSearchInput">Find a menu</label>
      <input id="dashboardNavSearchInput" type="search" autocomplete="off" placeholder="Search navigation..." />
      <div id="dashboardNavSearchResults" class="dashboard-nav-search-results" role="status" aria-live="polite"></div>
    </section>

    <main class="portal-content">
      @RenderBody()
    </main>
  </div>

  <script src="~/js/azunt-dashboard.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

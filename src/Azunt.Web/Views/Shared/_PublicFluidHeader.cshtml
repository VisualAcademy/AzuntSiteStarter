@using Azunt.Web.Models.Shells
<header class="az-site-header az-site-header--fluid" data-az-header>
  <svg class="az-icon-sprite" aria-hidden="true" focusable="false">
    <symbol id="az-i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8 4.8-2.2Z"></path></symbol>
    <symbol id="az-i-layers" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 16 9 5 9-5"></path></symbol>
    <symbol id="az-i-window" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M7 6.5h.01M10 6.5h.01"></path></symbol>
    <symbol id="az-i-book" viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z"></path><path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z"></path></symbol>
    <symbol id="az-i-code" viewBox="0 0 24 24"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 4l-4 16"></path></symbol>
    <symbol id="az-i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></symbol>
    <symbol id="az-i-gauge" viewBox="0 0 24 24"><path d="M4.3 18a9 9 0 1 1 15.4 0"></path><path d="m12 13 4-4"></path><path d="M12 18h.01"></path></symbol>
    <symbol id="az-i-shield" viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path></symbol>
    <symbol id="az-i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></symbol>
    <symbol id="az-i-rocket" viewBox="0 0 24 24"><path d="M14 5c3.5-2 6-2 7-2-0 1-.1 3.5-2 7l-5.5 5.5-5-5L14 5Z"></path><path d="m9 9-4 1-2 2 5 1M15 15l-1 4-2 2-1-5"></path><path d="M7 17c-1.6.3-3 1.7-3 3 1.3 0 2.7-1.4 3-3Z"></path></symbol>
    <symbol id="az-i-briefcase" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M9 7V4h6v3M3 12h18M10 12v2h4v-2"></path></symbol>
    <symbol id="az-i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></symbol>
    <symbol id="az-i-terminal" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="m7 9 3 3-3 3M12 16h5"></path></symbol>
    <symbol id="az-i-life" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"></circle><path d="m5.6 5.6 3.6 3.6M14.8 14.8l3.6 3.6M18.4 5.6l-3.6 3.6M9.2 14.8l-3.6 3.6"></path></symbol>
    <symbol id="az-i-handshake" viewBox="0 0 24 24"><path d="m8 12 3-3c1-1 2.2-1 3.2-.2l4.3 3.4"></path><path d="m3 9 4-4 4 3-5 6-3-5ZM21 9l-4-4-3 2"></path><path d="m7 14 5 5c1 1 2.5 1 3.5 0l3-3c.8-.8.8-2.2 0-3"></path></symbol>
    <symbol id="az-i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></symbol>
    <symbol id="az-i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"></path></symbol>
    <symbol id="az-i-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"></path></symbol>
    <symbol id="az-i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></symbol>
    <symbol id="az-i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></symbol>
    <symbol id="az-i-back" viewBox="0 0 24 24"><path d="M19 12H5M10 7l-5 5 5 5"></path></symbol>
  </svg>

  <div class="az-header-shell shell-width">
    <button class="az-mobile-toggle" type="button" aria-label="Open navigation" aria-controls="az-primary-nav-fluid" aria-expanded="false" data-az-nav-toggle>
      <svg class="az-icon az-icon-menu"><use href="#az-i-menu"></use></svg>
      <svg class="az-icon az-icon-close"><use href="#az-i-close"></use></svg>
    </button>

    <a class="brand az-header-brand" href="/" aria-label="Azunt home">
      <span class="brand-mark">A</span>
      <span class="az-brand-name">Azunt</span>
    </a>

    @* All Fluid dropdowns use the same More-menu markup and shared catalog.
       These IDs are separate from the regular mega-menu header. *@
    <nav class="az-primary-nav" id="az-primary-nav-fluid" aria-label="Primary navigation" data-az-primary-nav>
      <ul class="az-nav-list">
        @foreach (var item in FluidNavigation.Items)
        {
          <li class="az-nav-item az-nav-item--dropdown" data-az-menu-item>
            <button class="az-top-link az-top-button" type="button" aria-expanded="false" aria-controls="az-fluid-menu-@item.Id" data-az-menu-trigger>
              @item.Title <svg class="az-chevron" aria-hidden="true"><use href="#az-i-chevron"></use></svg>
            </button>
            <section class="az-dropdown" id="az-fluid-menu-@item.Id" aria-label="@item.Title" data-az-menu-panel hidden>
              <div class="az-mobile-panel-heading">
                <button type="button" class="az-back-button" data-az-menu-back><svg class="az-icon" aria-hidden="true"><use href="#az-i-back"></use></svg> Back</button>
                <strong>@item.Title</strong>
              </div>
              <ul class="az-dropdown-list">
                @foreach (var link in item.Links)
                {
                  <li><a class="az-dropdown-link" href="@link.Url"><span><strong>@link.Title</strong><small>@link.Description</small></span></a></li>
                }
                @foreach (var group in item.Groups)
                {
                  <li class="az-dropdown-nested">
                    <details data-az-dropdown-nested>
                      <summary class="az-dropdown-link az-dropdown-summary">
                        <span><strong>@group.Title</strong><small>@group.Description</small></span>
                        <svg class="az-dropdown-arrow" aria-hidden="true"><use href="#az-i-chevron"></use></svg>
                      </summary>
                      <ul class="az-dropdown-submenu">
                        @foreach (var link in group.Links)
                        {
                          <li><a href="@link.Url"><strong>@link.Title</strong><small>@link.Description</small></a></li>
                        }
                      </ul>
                    </details>
                  </li>
                }
              </ul>
            </section>
          </li>
        }
      </ul>
    </nav>

    <div class="az-header-actions">
      <a class="az-icon-action" href="/docs/" aria-label="Documentation" title="Documentation"><svg class="az-icon"><use href="#az-i-code"></use></svg></a>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a class="az-account-link" href="/account/profile"><span class="az-account-avatar" aria-hidden="true"><svg><use href="#az-i-user"></use></svg></span><span class="az-account-text">@User.Identity.Name</span></a>
        <form method="post" action="/account/logout" class="az-signout-form">
          @Html.AntiForgeryToken()
          <button class="az-header-quiet" type="submit">Sign out</button>
        </form>
      }
      else
      {
        <div class="az-signin-menu" data-az-action-menu>
          <button class="az-header-quiet az-signin-trigger" type="button" aria-expanded="false" aria-controls="az-signin-dropdown" data-az-action-trigger>
            Sign in <svg class="az-signin-chevron"><use href="#az-i-chevron"></use></svg>
          </button>
          <div class="az-action-dropdown" id="az-signin-dropdown" data-az-action-panel hidden>
            <div class="az-action-dropdown-title">Account</div>
            <a href="/account/login"><strong>Sign in</strong><small>Access your Azunt account</small></a>
            <a href="/account/register"><strong>Create account</strong><small>Set up a new account</small></a>
            <a href="/dashboard"><strong>Open dashboard</strong><small>Go to the authenticated workspace</small></a>
          </div>
        </div>
        <a class="az-header-cta" href="/account/register">Start free <svg><use href="#az-i-arrow"></use></svg></a>
      }
    </div>
  </div>
  <div class="az-menu-scrim" data-az-menu-scrim></div>
</header>

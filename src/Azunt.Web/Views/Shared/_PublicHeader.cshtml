              <strong>Company</strong>
            </div>
            <div class="az-mega-inner az-company-grid">
              <div class="az-company-intro">
                <span class="az-menu-kicker">Azunt</span>
                <h2>A clean foundation for sites that need to grow beyond a landing page.</h2>
                <p>Use the starter as a reference architecture, a commercial product shell, or the base for your next internal platform.</p>
              </div>
              <div class="az-company-links">
                <a href="/"><strong>About Azunt Starter</strong><small>See the complete experience</small><svg><use href="#az-i-arrow"></use></svg></a>
                <a href="/products"><strong>Architecture</strong><small>Explore the product areas</small><svg><use href="#az-i-arrow"></use></svg></a>
                <a href="/resources/site-structure"><strong>Site structure</strong><small>Understand source boundaries</small><svg><use href="#az-i-arrow"></use></svg></a>
                <a href="/pricing"><strong>Commercialize</strong><small>Start from the pricing shell</small><svg><use href="#az-i-arrow"></use></svg></a>
              </div>
            </div>
          </section>
        </li>
      </ul>
    </nav>

    <div class="az-header-actions">
      <a class="az-icon-action" href="/docs/" aria-label="Documentation" title="Documentation"><svg class="az-icon"><use href="#az-i-code"></use></svg></a>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a class="az-account-link" href="/account/profile"><span class="az-account-avatar" aria-hidden="true"><svg><use href="#az-i-user"></use></svg></span><span class="az-account-text">@User.Identity.Name</span></a>
        <form method="post" action="/account/logout" class="az-signout-form">
          @Html.AntiForgeryToken()
          <button class="az-header-quiet" type="submit">Sign out</button>
        </form>
      }
      else
      {
        <a class="az-header-quiet" href="/account/login">Sign in</a>
        <a class="az-header-cta" href="/account/register">Start free <svg><use href="#az-i-arrow"></use></svg></a>
      }
    </div>
  </div>
  <div class="az-menu-scrim" data-az-menu-scrim></div>
</header>
